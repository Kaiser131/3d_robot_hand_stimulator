<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6" />
  <Project>
    <Option title="RobotArmSimulation" />
    <Option pch_mode="2" />
    <Option compiler="gcc" />
    <Build>
      <Target title="Debug">
        <Option output="bin/Debug/RobotArmSimulation" prefix_auto="1" extension_auto="1" />
        <Option object_output="obj/Debug/" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler>
          <Add option="-g" />
          <Add option="-std=gnu++17" />
        </Compiler>
        <Linker>
          <Add library="glut32" />
          <Add library="opengl32" />
          <Add library="glu32" />
          <Add library="winmm" />
          <Add library="gdi32" />
        </Linker>
      </Target>
      <Target title="Release">
        <Option output="bin/Release/RobotArmSimulation" prefix_auto="1" extension_auto="1" />
        <Option object_output="obj/Release/" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler>
          <Add option="-O2" />
          <Add option="-std=gnu++17" />
          <Add option="-DNDEBUG" />
        </Compiler>
        <Linker>
          <Add option="-s" />
          <Add library="glut32" />
          <Add library="opengl32" />
          <Add library="glu32" />
          <Add library="winmm" />
          <Add library="gdi32" />
        </Linker>
      </Target>
    </Build>

    <Compiler>
      <Add option="-Wall" />
      <Add directory="src" />
    </Compiler>

    <Unit filename="src\\main.cpp" />
    <Unit filename="src\\RobotArm.cpp" />
    <Unit filename="src\\RobotArm.h" />
    <Unit filename="src\\Camera.cpp" />
    <Unit filename="src\\Camera.h" />
    <Unit filename="src\\SceneObject.cpp" />
    <Unit filename="src\\SceneObject.h" />
    <Unit filename="src\\InputState.cpp" />
    <Unit filename="src\\InputState.h" />
    <Unit filename="src\\MathUtil.cpp" />
    <Unit filename="src\\MathUtil.h" />

    <Extensions>
      <code_completion />
      <debugger />
    </Extensions>
  </Project>
</CodeBlocks_project_file>
